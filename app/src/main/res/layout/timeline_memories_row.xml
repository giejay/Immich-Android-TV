<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed-size memory cards. End clearance + clipToPadding keep resting cards off the
  scrubber; clipChildren=false on the parent mosaic still lets focus scale cover the rail.
  The layout manager and card spacing are set in TimelineMosaicAdapter.
-->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeline_memories_grid"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:clipChildren="false"
    android:clipToPadding="true"
    android:descendantFocusability="afterDescendants"
    android:focusable="true"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingEnd="@dimen/timeline_memories_end_clearance" />
