<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): same exclusion for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="io.github.daniii88.immichandroidtvnext_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="io.github.daniii88.immichandroidtvnext_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
